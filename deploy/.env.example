# K Garden stack settings. On the server: ~/server/apps/kgarden/.env, chmod 600. Never commit it.
# Generate secrets with:  openssl rand -hex 24

# ERPNext
ERP_SITE='erp.kgarden.co.th'
ERP_PUBLIC_URL='https://erp.kgarden.co.th'
ERP_PORT='8010'
ERP_ADMIN_PASSWORD=
PG_SUPERUSER_PASSWORD=
GUNICORN_WORKERS='3'
ERPNEXT_TAG='latest'
# Setup wizard (kg.sh setup-company): confirm the chart of accounts with accounting first
COMPANY_NAME='K Garden'
COMPANY_ABBR='KG'
COMPANY_LANGUAGE='th'
CHART_OF_ACCOUNTS='Standard'
ADMIN_EMAIL=  # first ERPNext user (a real person, not admin@example.com)
# Addresses of the apps that sign in through ERPNext (OAuth redirect addresses, kg.sh provision)
CERP_PUBLIC_URL='https://construction.kgarden.co.th'
WMS_PUBLIC_URL='https://pos.kgarden.co.th'

# MES + floor tablets
MES_PUBLIC_URL='https://mes.kgarden.co.th'
MES_PORT='8011'
MES_ORG_ID=  # uuid, fixed for the life of the install
KG_MES_OWNER_PASSWORD=
KG_MES_APP_PASSWORD=
MES_ERPNEXT_API_KEY=  # ERPNext integration user (Stock User, Manufacturing User)
MES_ERPNEXT_API_SECRET=
MES_ACCESS_API_KEY=  # ERPNext service account with role KG Access Service
MES_ACCESS_API_SECRET=
MES_OIDC_CLIENT_ID=  # OAuth Client "MES_FLOOR" in ERPNext
MES_OIDC_CLIENT_SECRET=
PLATFORM_TAG='latest'

# ConstructionERP bridge (kgf_construction in kgf-postgres, read-only role)
CERP_DB_URL='postgres://cerp_bridge:PASSWORD@kgf-postgres:5432/kgf_construction'
CERP_ERPNEXT_API_KEY=
CERP_ERPNEXT_API_SECRET=
CERP_BRIDGE_COMPANY='KGF Construction'
CERP_BRIDGE_VAT_ACCOUNT=
CERP_BRIDGE_WHT_ACCOUNT=
CERP_BRIDGE_SUPPLIER_GROUP=

# WMS bridge: set WMS_ENABLED=1 once the droplet's MySQL is reachable over Tailscale
WMS_ENABLED='0'
WMS_DB_DSN='kgarden_bridge:PASSWORD@tcp(100.x.y.z:3306)/production_pos?parseTime=true'
WMS_ERPNEXT_API_KEY=
WMS_ERPNEXT_API_SECRET=
WMS_BRIDGE_COMPANY='K Garden'
WMS_BRIDGE_PARENT_WAREHOUSE=
WMS_BRIDGE_TRANSIT_WAREHOUSE=
WMS_BRIDGE_WIP_WAREHOUSE=
WMS_BRIDGE_FG_STAGING_WAREHOUSE=
