MES_DB_OWNER_URL=
MES_DB_URL=
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# WMS -> ERPNext bridge (services/wms-bridge); WMS_DB_DSN uses a read-only MySQL user
WMS_DB_DSN=
WMS_TIMEZONE=Asia/Bangkok
WMS_BRIDGE_HTTP_ADDR=127.0.0.1:8101
WMS_BRIDGE_COMPANY="K Garden"
WMS_BRIDGE_PARENT_WAREHOUSE=
WMS_BRIDGE_TRANSIT_WAREHOUSE=
WMS_BRIDGE_CREATE_MASTERS=0
# Production flow: WMS cut/consumption -> WIP (MES backflushes), WMS FG receive <- MES output warehouse
WMS_BRIDGE_WIP_WAREHOUSE=
WMS_BRIDGE_FG_STAGING_WAREHOUSE=

# ConstructionERP -> ERPNext bridge (services/cerp-bridge); CERP_DB_URL is a read-only role,
# CERP_ERPNEXT_* the keys of the ERPNext user cerp.integration@example.com
CERP_DB_URL=
CERP_ERPNEXT_API_KEY=
CERP_ERPNEXT_API_SECRET=
CERP_BRIDGE_HTTP_ADDR=127.0.0.1:8102
CERP_BRIDGE_COMPANY="KGF Construction"
CERP_BRIDGE_VAT_ACCOUNT="VAT - KGFC"
CERP_BRIDGE_SUPPLIER_GROUP="Local"
CERP_BRIDGE_WHT_ACCOUNT="ภาษีหัก ณ ที่จ่ายค้างจ่าย - KGFC"

# MES sign-in (access managed in ERPNext, app MES_FLOOR)
MES_ACCESS_API_KEY=
MES_ACCESS_API_SECRET=
MES_OIDC_CLIENT_ID=
MES_OIDC_CLIENT_SECRET=
MES_OIDC_REDIRECT_URI=http://127.0.0.1:5180/auth/callback
MES_SESSION_TTL=12h
MES_ACCESS_POLL=1m
MES_WORK_ORDER_SYNC=15s
MES_MATERIAL_RETRY=10s
# e2e test people (local ERPNext only)
MES_E2E_OPERATOR=
MES_E2E_OPERATOR_PIN=
MES_E2E_SUPERVISOR=
MES_E2E_SUPERVISOR_PIN=
